{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PaymentPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${payment_bucket_arn}/payment-reconciler/*"
    },
    {
      "Sid": "InventoryObjectAllowedHere",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${inventory_bucket_arn}/inventory-worker/*"
    }
  ]
}
