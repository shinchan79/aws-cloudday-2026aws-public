# Copy this file to accounts.env and fill it in.
# accounts.env is gitignored. Do not commit it.
# Use one region for all three accounts. The three account IDs must differ.
AWS_REGION=us-east-1
IDENTITY_AWS_ACCESS_KEY_ID=
IDENTITY_AWS_SECRET_ACCESS_KEY=
IDENTITY_AWS_SESSION_TOKEN=
PAYMENT_AWS_ACCESS_KEY_ID=
PAYMENT_AWS_SECRET_ACCESS_KEY=
PAYMENT_AWS_SESSION_TOKEN=
INVENTORY_AWS_ACCESS_KEY_ID=
INVENTORY_AWS_SECRET_ACCESS_KEY=
INVENTORY_AWS_SESSION_TOKEN=
